# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Шаблон окружения хранится в репозитории: сервер после git clone копирует его
# в .env (DEPLOY.md стадия A3). Сами секреты (.env) по-прежнему игнорируются.
!.env.example

# локальная база данных (создаётся миграцией, не хранится в репозитории)
# на сервере эта же папка примонтирована томом db-data
/prisma/data/

# загруженные файлы: содержимое студии, а не код. На сервере эта папка
# примонтирована томом uploads (docker-compose.yml), в репозиторий не идёт
/public/uploads/

# снимки данных (scripts/data-snapshot.ts) и резервные копии: там лежит копия
# базы вместе с персональными данными заявок. В репозиторий не идут никогда
/backups/

# настройки редакторов
/.idea/

# заготовки для копирования по README.md: раскладываются по месту и не
# входят в репозиторий, как и предыдущие партии заготовок раньше
/starter/

# отчёты и трассы сквозных тестов
/playwright-report/
/test-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Word/Office документы и временные локи (не исходники проекта)
*.docx
~$*
