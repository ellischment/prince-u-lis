# Что НЕ копировать в образ. Ускоряет сборку и не пускает лишнее внутрь.
# Секреты (.env) сюда попадать не должны: они приходят через env_file в
# docker-compose, а не запекаются в слой образа.

node_modules
.next
out
build
coverage

.git
.gitignore

# Секреты и локальные окружения
.env
.env.*
!.env.example

# Локальная база и загруженные файлы: на сервере это тома, не часть образа.
prisma/data
public/uploads

# Артефакты тестов и разработки
playwright-report
test-results
*.log
.DS_Store

# Документация проекта в образе не нужна
*.md
!prisma/**/*.md
