# Тестовый домен. Отличается от боевого Caddyfile двумя вещами: адресом и
# паролем на вход. Раньше это жило локальной правкой прямо на сервере, из-за
# чего `git pull` при выкатке ломался, как только Caddyfile менялся в
# репозитории. Теперь оба варианта лежат в репозитории, а какой взять —
# решает переменная CADDYFILE в .env (docker-compose.yml).
#
# Нужные переменные в .env на сервере:
#   CADDYFILE=Caddyfile.test
#   TEST_DOMAIN=80-78-253-177.sslip.io
#   TEST_AUTH_USER=studia
#   TEST_AUTH_HASH=<bcrypt-хэш пароля, caddy hash-password>

{$TEST_DOMAIN} {
	encode gzip zstd

	request_body {
		max_size 12MB
	}

	basic_auth {
		{$TEST_AUTH_USER} {$TEST_AUTH_HASH}
	}

	# Заглушка на время работ, как на боевом домене: страницу отдаёт сам Caddy,
	# поэтому она видна и при остановленном приложении.
	root * /srv/maintenance
	@maintenance file /ON

	handle @maintenance {
		header Retry-After 3600
		header Cache-Control "no-store"
		rewrite * /index.html
		file_server {
			status 503
		}
	}

	handle {
		reverse_proxy app:3000 {
			# X-Forwarded-For задаём сами, а не доверяем присланному. По умолчанию
			# Caddy ДОПИСЫВАЕТ реальный адрес к тому, что прислал клиент, а
			# приложение берёт из заголовка первое значение — значит гость мог
			# подставить туда что угодно. От этого заголовка зависят обе защиты:
			# лимит «5 заявок с адреса за 10 минут» и блокировка входа в панель
			# после пяти неверных паролей. Подделав заголовок, обе можно было
			# обходить, а в журнал заявок попадал выдуманный адрес.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}
