princulissart.ru, www.princulissart.ru {
	encode gzip zstd

	# Ограничение размера тела запроса на уровне прокси.
	# Приложение ограничивает тоже, но проксии дешевле отбить раньше.
	request_body {
		max_size 12MB
	}

	# Заголовки безопасности (CSP, HSTS, X-Content-Type-Options, Referrer-Policy,
	# X-Frame-Options) ставит само приложение в next.config.ts — единый источник,
	# и только там есть CSP. Дублировать их здесь нельзя: заголовки задвоятся, а
	# X-Frame-Options c разными значениями (SAMEORIGIN у Caddy против DENY у app)
	# браузер может счесть конфликтом. Caddy отвечает за TLS, сжатие и лимит тела.

	reverse_proxy app:3000
}
