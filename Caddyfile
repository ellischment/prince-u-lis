princulissart.ru, www.princulissart.ru {
	encode gzip zstd

	# Журнал обращений. Без него не видно ни поисковых роботов, ни всплесков
	# нагрузки: при подтверждении прав в Search Console мы не могли даже
	# понять, дошёл ли до нас Googlebot. Пишется в поток контейнера, его
	# ротацию держит docker-compose (max-size 10m, max-file 3), отдельный том
	# не нужен. Смотреть: docker compose logs caddy | grep -i googlebot
	# ВНИМАНИЕ: в журнал попадают IP-адреса, а это персональные данные по
	# 152-ФЗ. В политике хранение IP пока не описано — см. открытый вопрос в
	# STATE.md, решать вместе со студией.
	log

	# Ограничение размера тела запроса на уровне прокси.
	# Приложение ограничивает тоже, но проксии дешевле отбить раньше.
	request_body {
		max_size 12MB
	}

	# Заголовки безопасности (CSP, HSTS, X-Content-Type-Options, Referrer-Policy,
	# X-Frame-Options) ставит само приложение в next.config.ts — единый источник,
	# и только там есть CSP. Дублировать их здесь нельзя: заголовки задвоятся, а
	# X-Frame-Options c разными значениями (SAMEORIGIN у Caddy против DENY у app)
	# браузер может счесть конфликтом. Caddy отвечает за TLS, сжатие и лимит тела.

	# Заглушка на время работ. Включается появлением файла-флага
	# deploy/maintenance/ON (scripts/maintenance-on.sh), выключается его
	# удалением. Страницу отдаёт сам Caddy из файла, поэтому она работает и
	# когда контейнер приложения остановлен — ради этого всё и сделано.
	root * /srv/maintenance
	# Заглушка НЕ закрывает панель и то, из чего она состоит: студия должна
	# наполнять сайт, пока гость видит «обновляем». Загрузки нужны в предпросмотре
	# карточек, статика — чтобы панель не осталась без стилей и скриптов.
	@maintenance {
		file /ON
		not path /admin /admin/* /_next/* /uploads/* /api/media/upload
	}

	handle @maintenance {
		# 503 с Retry-After, а не 200: поисковик поймёт, что это временно, и не
		# запомнит заглушку вместо сайта. Отдаём её на ЛЮБОЙ адрес.
		header Retry-After 3600
		header Cache-Control "no-store"
		rewrite * /index.html
		file_server {
			status 503
		}
	}

	handle {
		reverse_proxy app:3000 {
			# Выкатка не должна ронять сайт. Сборка идёт на живом контейнере, но в
			# конце старый подменяется новым, и несколько секунд приложение не
			# отвечает. По умолчанию Caddy в этот момент отдаёт 502, поэтому
			# приходилось закрывать сайт заглушкой на всё время выкатки. С этими
			# двумя строками Caddy вместо ошибки ПОДОЖДЁТ и повторит попытку: гость
			# видит чуть более долгую загрузку вместо ошибки, заглушка не нужна.
			# Тридцати секунд хватает с запасом: приложение поднимается за пять.
			lb_try_duration 30s
			lb_try_interval 250ms

			# X-Forwarded-For задаём сами, а не доверяем присланному. По умолчанию
			# Caddy ДОПИСЫВАЕТ реальный адрес к тому, что прислал клиент, а
			# приложение берёт из заголовка первое значение — значит гость мог
			# подставить туда что угодно. От этого заголовка зависят обе защиты:
			# лимит «5 заявок с адреса за 10 минут» и блокировка входа в панель
			# после пяти неверных паролей. Подделав заголовок, обе можно было
			# обходить, а в журнал заявок попадал выдуманный адрес.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}
}
