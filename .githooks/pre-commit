#!/bin/sh
# Проверки перед коммитом. Всё на конвейерах grep, без построчных циклов:
# на Windows Git Bash порождение процесса на строку делает хук минутным.
#
# Чтобы включить у себя: git config core.hooksPath .githooks
# (в этой рабочей копии уже включено копией в .git/hooks/pre-commit).

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

# --- 1. Секреты: жёсткий стоп ---

if printf '%s\n' "$staged_files" | grep -qx '\.env'; then
  echo "Коммит отклонён: .env в индексе. Секреты не попадают в git (DEPLOY.md р. B5)." >&2
  exit 1
fi

# Только добавленные строки, .githooks исключён — иначе этот файл бьёт сам себя
# словами из своих же комментариев.
added_lines=$(git diff --cached -U0 -- . ':(exclude).githooks' | grep -E '^\+' | grep -vE '^\+\+\+')

# Утечка — секрет, которого не должно быть в репозитории, а не само слово
# token/secret/password (оно легально в именах переменных и в process.env.X).
# Признак: сразу после = или : идёт 16+ символов base64/JWT-алфавита. Явные
# тестовые плейсхолдеры отсеиваются вторым grep -v. Три grep в конвейере дают ту
# же логику «И», что прежний построчный цикл, но без тысяч процессов.
entropy_pattern="(token|secret|password)[^=:]{0,30}[=:][[:space:]]*[\"']?[A-Za-z0-9+/_.=-]{16,}"
suspicious=$(printf '%s\n' "$added_lines" \
  | grep -iE 'token|secret|password' \
  | grep -viE 'not-real|changeme|change-me|example|placeholder|ci-owner|ci-admin|=[[:space:]]*(null|"")[[:space:]]*$' \
  | grep -iE "$entropy_pattern")

if [ -n "$suspicious" ]; then
  echo "Коммит отклонён: похоже на настоящий секрет в добавленных строках (DEPLOY.md р. B5):" >&2
  printf '%s\n' "$suspicious" >&2
  echo "Если это ложное срабатывание (тестовый плейсхолдер без своей метки), проверьте вручную." >&2
  exit 1
fi

# --- 2. STATE.md: мягкое предупреждение, не блок ---

if printf '%s\n' "$staged_files" | grep -qE '^(lib|app|components|prisma)/'; then
  if ! printf '%s\n' "$staged_files" | grep -qx 'STATE.md'; then
    echo "Предупреждение: меняется код (lib/app/components/prisma), а STATE.md не в этом коммите." >&2
  fi
fi

# --- 3. Дизайн-замок (DESIGN-LOCK.md): цвет и шкала ---
#
# Токены цвета определяются только в токен-файлах, поэтому сырой hex там
# разрешён и они исключены из проверки. Везде ещё сплошной цвет — через var(--*).
# Градиенты, тени и flood-цвета исключены: канон site-4-2-2 сам держит там
# не-токенные оттенки, блок запретил бы точную копию макета.
added_style=$(git diff --cached -U0 -- '*.css' '*.tsx' \
  ':(exclude)app/globals.css' \
  ':(exclude)app/admin/admin.module.css' \
  ':(exclude)lib/appearance.ts' \
  ':(exclude)DESIGN-LOCK.md' \
  | grep -E '^\+' | grep -vE '^\+\+\+')

hex_hits=$(printf '%s\n' "$added_style" \
  | grep -viE 'gradient\(|flood|shadow' \
  | grep -E '#[0-9A-Fa-f]{3,8}')

if [ -n "$hex_hits" ]; then
  echo "Коммит отклонён: сырой hex вне токен-файлов (DESIGN-LOCK.md). Через var(--*):" >&2
  printf '%s\n' "$hex_hits" >&2
  echo "Если это градиент/тень с оттенком макета — добавьте gradient/shadow/flood в строку или токен в globals.css." >&2
  exit 1
fi

# Новые px мимо сетки 4px — мягкое предупреждение, не блок.
px_values=$(printf '%s\n' "$added_style" \
  | grep -oE '[0-9]+px' \
  | awk -F px '{ if ($1 % 4 != 0) print $1"px" }' \
  | sort -u | tr '\n' ' ')

if [ -n "$px_values" ]; then
  echo "Предупреждение (DESIGN-LOCK.md): новые px вне сетки 4px: $px_values" >&2
  echo "Сверьте с макетом 4-2-2 на 320/390/1440, прежде чем принимать." >&2
fi

exit 0
