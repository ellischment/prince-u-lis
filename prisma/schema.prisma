// Prisma schema — «Принц и Лис» (этап 1)
// Актуальная ER-диаграмма: docs/db.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// КАТАЛОГ УСЛУГ
// ─────────────────────────────────────────────

model Category {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  sortOrder Int               @default(0)
  services  ServiceCategory[]
}

model Service {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  desc        String
  longDesc    String?
  level       String
  forWhom     String?
  priceRub    Int
  unit        String
  durationMin Int
  capacity    Int                  @default(6)
  glazeColor  String
  active      Boolean              @default(true)
  sortOrder   Int                  @default(0)
  categories  ServiceCategory[]
  program     ServiceProgramItem[]
  includes    ServiceIncludeItem[]
  slots       Slot[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ServiceCategory {
  serviceId  String
  categoryId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([serviceId, categoryId])
}

model ServiceProgramItem {
  id        String  @id @default(cuid())
  serviceId String
  text      String
  sortOrder Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceIncludeItem {
  id        String  @id @default(cuid())
  serviceId String
  text      String
  sortOrder Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// РАСПИСАНИЕ И СЛОТЫ
// ─────────────────────────────────────────────

model ScheduleRule {
  id        String @id @default(cuid())
  /// 0 = Вс, 1 = Пн, 2 = Вт, 3 = Ср, 4 = Чт, 5 = Пт, 6 = Сб (как Date.getDay())
  weekday   Int
  startTime String // HH:MM
  title     String
  serviceId String?
}

enum SlotSource {
  rule
  manual
}

model Slot {
  id        String     @id @default(cuid())
  serviceId String
  startsAt  DateTime
  capacity  Int
  source    SlotSource @default(rule)
  service   Service    @relation(fields: [serviceId], references: [id])
  bookings  Booking[]

  @@unique([serviceId, startsAt])
}

// ─────────────────────────────────────────────
// КЛИЕНТЫ И ЗАПИСИ
// ─────────────────────────────────────────────

model Client {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  visitsCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  anonymizedAt DateTime?
  bookings     Booking[]
  consents     Consent[]
}

model Consent {
  id         String   @id @default(cuid())
  clientId   String
  docVersion String   @default("1.0")
  acceptedAt DateTime @default(now())
  ip         String
  client     Client   @relation(fields: [clientId], references: [id])
}

enum BookingStatus {
  new
  confirmed
  done
  cancelled
  no_show
}

enum ContactChannel {
  tg
  wa
  sms
  call
}

model Booking {
  id             String         @id @default(cuid())
  slotId         String
  clientId       String
  status         BookingStatus  @default(new)
  contactChannel ContactChannel
  tgUsername     String?
  comment        String?
  promoCodeId    String? // этап 5
  createdAt      DateTime       @default(now())
  slot           Slot           @relation(fields: [slotId], references: [id])
  client         Client         @relation(fields: [clientId], references: [id])
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id])
}

// ─────────────────────────────────────────────
// АКЦИИ И ПРОМОКОДЫ
// ─────────────────────────────────────────────

enum PromoType {
  promo
  event
}

model Promo {
  id         String    @id @default(cuid())
  type       PromoType
  title      String
  text       String
  activeFrom DateTime?
  activeTo   DateTime?
  active     Boolean   @default(true)
}

enum PromoCodeKind {
  percent
  fixed
}

model PromoCode {
  id        String        @id @default(cuid())
  code      String        @unique
  kind      PromoCodeKind
  value     Int
  limit     Int?
  used      Int           @default(0)
  active    Boolean       @default(true)
  expiresAt DateTime?
  note      String?
  bookings  Booking[]
}

// ─────────────────────────────────────────────
// ПОЛЬЗОВАТЕЛИ И АУДИТ
// ─────────────────────────────────────────────

enum UserRole {
  owner
  admin
  tech
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  role         UserRole
  passwordHash          String
  sessionsInvalidatedAt DateTime?
  createdAt             DateTime   @default(now())
  auditLogs    AuditLog[]
}

model ContentText {
  key   String @id
  label String
  value String
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?  // null для системных событий (напр. login_failed с неизвестным email)
  action   String
  entity   String
  entityId String
  payload  Json     @default("{}")
  at       DateTime @default(now())
  actor    User?    @relation(fields: [actorId], references: [id])
}
