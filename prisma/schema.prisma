// Prisma schema — «Принц и Лис» (этап мастеров)
// Актуальная ER-диаграмма: docs/db.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// КАТАЛОГ УСЛУГ
// ─────────────────────────────────────────────

/// Формат проведения занятия — влияет на шаг 2 визарда записи
enum ServiceFormat {
  group            // групповой мастер-класс — сетка дат/времени
  individual       // индивидуальное — выбор мастера → его календарь
  course_group     // курс (группа) — просто информация + контакт
  course_individual // курс (индивидуальный)
  subscription     // абонемент — выбор тарифа + заявка администратору
  seasonal         // сезонный формат (пленэры и т.п.)
}

model Category {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  sortOrder Int               @default(0)
  services  ServiceCategory[]
}

model Service {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  desc        String
  longDesc    String?
  level       String
  forWhom     String?
  priceRub    Int
  unit        String
  durationMin Int
  capacity    Int                  @default(6)
  glazeColor  String
  active      Boolean              @default(true)
  sortOrder   Int                  @default(0)
  format      ServiceFormat        @default(group)
  categories  ServiceCategory[]
  program     ServiceProgramItem[]
  includes    ServiceIncludeItem[]
  slots       Slot[]
  priceTiers  PriceTier[]
  masters     ServiceMaster[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ServiceCategory {
  serviceId  String
  categoryId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([serviceId, categoryId])
}

model ServiceProgramItem {
  id        String  @id @default(cuid())
  serviceId String
  text      String
  sortOrder Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceIncludeItem {
  id        String  @id @default(cuid())
  serviceId String
  text      String
  sortOrder Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

/// Ценовые тиры для абонементов (subscription)
model PriceTier {
  id        String  @id @default(cuid())
  serviceId String
  label     String  // напр. «4 занятия», «8 занятий»
  priceRub  Int
  sortOrder Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// МАСТЕРА
// ─────────────────────────────────────────────

model Master {
  id         String                  @id @default(cuid())
  name       String
  photo      String?                 // URL или путь к фото
  bio        String?
  active     Boolean                 @default(true)
  createdAt  DateTime                @default(now())
  services   ServiceMaster[]
  rules      MasterAvailabilityRule[]
  exceptions MasterException[]
  slots      Slot[]
}

/// M2M: мастер ведёт конкретную услугу (индивидуальные занятия)
model ServiceMaster {
  serviceId String
  masterId  String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  master    Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@id([serviceId, masterId])
}

/// Шаблон доступности мастера по дням недели
model MasterAvailabilityRule {
  id        String @id @default(cuid())
  masterId  String
  /// 0 = Вс, 1 = Пн, 2 = Вт, 3 = Ср, 4 = Чт, 5 = Пт, 6 = Сб
  weekday   Int
  startTime String // HH:MM
  endTime   String // HH:MM
  master    Master @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

enum MasterExceptionKind {
  closed // мастер не работает в этот день (или в указанное время)
  extra  // дополнительное время вне шаблона
}

/// Точечные исключения из шаблона (выходной или доп. слот)
model MasterException {
  id        String              @id @default(cuid())
  masterId  String
  date      DateTime            // дата (время 00:00 UTC)
  kind      MasterExceptionKind
  startTime String?             // только для extra: начало
  endTime   String?             // только для extra: конец
  master    Master @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// РАСПИСАНИЕ И СЛОТЫ
// ─────────────────────────────────────────────

model ScheduleRule {
  id        String @id @default(cuid())
  /// 0 = Вс, 1 = Пн, 2 = Вт, 3 = Ср, 4 = Чт, 5 = Пт, 6 = Сб (как Date.getDay())
  weekday   Int
  startTime String // HH:MM
  title     String
  serviceId String?
}

enum SlotSource {
  rule
  manual
}

model Slot {
  id        String     @id @default(cuid())
  serviceId String
  masterId  String?    // null = групповой слот, String = индивидуальный (конкретный мастер)
  startsAt  DateTime
  capacity  Int
  source    SlotSource @default(rule)
  service   Service    @relation(fields: [serviceId], references: [id])
  master    Master?    @relation(fields: [masterId], references: [id])
  bookings  Booking[]

  // NULL != NULL в PostgreSQL, поэтому для групповых слотов уникальность
  // контролируется на уровне приложения (findFirst перед create в generateSlots).
  // Для индивидуальных слотов (masterId != null) уникальность гарантирует этот индекс.
  @@unique([serviceId, startsAt, masterId])
}

// ─────────────────────────────────────────────
// КЛИЕНТЫ И ЗАПИСИ
// ─────────────────────────────────────────────

model Client {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  visitsCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  anonymizedAt DateTime?
  bookings     Booking[]
  consents     Consent[]
}

model Consent {
  id         String   @id @default(cuid())
  clientId   String
  docVersion String   @default("1.0")
  acceptedAt DateTime @default(now())
  ip         String
  client     Client   @relation(fields: [clientId], references: [id])
}

enum BookingStatus {
  new
  confirmed
  done
  cancelled
  no_show
}

enum ContactChannel {
  tg
  wa
  sms
  call
}

model Booking {
  id             String         @id @default(cuid())
  slotId         String
  clientId       String
  status         BookingStatus  @default(new)
  contactChannel ContactChannel
  tgUsername     String?
  comment        String?
  promoCodeId    String? // этап 5
  createdAt      DateTime       @default(now())
  slot           Slot           @relation(fields: [slotId], references: [id])
  client         Client         @relation(fields: [clientId], references: [id])
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id])
}

// ─────────────────────────────────────────────
// АКЦИИ И ПРОМОКОДЫ
// ─────────────────────────────────────────────

enum PromoType {
  promo
  event
}

model Promo {
  id         String    @id @default(cuid())
  type       PromoType
  title      String
  text       String
  activeFrom DateTime?
  activeTo   DateTime?
  active     Boolean   @default(true)
}

enum PromoCodeKind {
  percent
  fixed
}

model PromoCode {
  id        String        @id @default(cuid())
  code      String        @unique
  kind      PromoCodeKind
  value     Int
  limit     Int?
  used      Int           @default(0)
  active    Boolean       @default(true)
  expiresAt DateTime?
  note      String?
  bookings  Booking[]
}

// ─────────────────────────────────────────────
// ПОЛЬЗОВАТЕЛИ И АУДИТ
// ─────────────────────────────────────────────

enum UserRole {
  owner
  admin
  tech
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  name                  String
  role                  UserRole
  passwordHash          String
  sessionsInvalidatedAt DateTime?
  createdAt             DateTime   @default(now())
  auditLogs             AuditLog[]
}

model ContentText {
  key   String @id
  label String
  value String
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?  // null для системных событий (напр. login_failed с неизвестным email)
  action   String
  entity   String
  entityId String
  payload  Json     @default("{}")
  at       DateTime @default(now())
  actor    User?    @relation(fields: [actorId], references: [id])
}
