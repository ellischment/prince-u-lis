# Скопировать в .env и заполнить. Файл .env в .gitignore, в репозиторий не попадает.

# Путь считается от папки prisma, поэтому это prisma/data/dev.db.
# Именно сюда монтируется том db-data из docker-compose.yml: файл рядом
# со схемой оказался бы вне тома, и обновление образа стёрло бы базу.
DATABASE_URL="file:./data/dev.db"

# Длинные случайные строки. Сгенерировать: openssl rand -base64 32
SESSION_SECRET=""
ENCRYPTION_KEY=""
CRON_SECRET=""

# Пользователи панели при заполнении базы. Пароль минимум десять символов.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Telegram: бот через @BotFather, chat_id командного чата
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# amoCRM: долгосрочный токен из настроек интеграции (не OAuth2)
AMO_SUBDOMAIN=""
AMO_ACCESS_TOKEN=""
# Общая воронка и этап для всех заявок. Пусто — amoCRM кладёт в основную воронку.
AMO_PIPELINE_ID=""
AMO_STATUS_ID=""
# Необязательно: своя воронка под тип заявки. Например, продажи работ в отдельную
# воронку — завести её в amoCRM и вписать её id сюда (покупки уйдут туда, остальное
# в общую). По той же схеме: AMO_PIPELINE_ID_BOOKING/CELEBRATION/PARTNERSHIP/FREE_TIME,
# при желании и AMO_STATUS_ID_<ТИП> под свой первый этап.
AMO_PIPELINE_ID_PURCHASE=""

# Публичный адрес, нужен для ссылок в уведомлениях и карте сайта
NEXT_PUBLIC_SITE_URL="https://princulissart.ru"

# Закрыть сайт от индексации целиком. Ставится в "1" ТОЛЬКО на тестовом домене
# (DEPLOY.md стадия A4): приложение отдаёт robots.txt с полным запретом и
# заголовок X-Robots-Tag: noindex. На боевом домене оставить пустым.
NEXT_PUBLIC_NOINDEX=""

# Номер счётчика Яндекс.Метрики. Пусто — статистика не подключается вовсе
# (сайт работает без неё). Подключается только после согласия гостя на cookie.
NEXT_PUBLIC_METRIKA_ID=""
